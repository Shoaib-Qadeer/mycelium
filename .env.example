# MongoDB Atlas connection string (the same cluster as Compass is fine; data goes in its own database)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mycelium

# NextAuth
NEXTAUTH_URL=https://mycelium-lpi.vercel.app
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# Google OAuth (Google Cloud console > APIs & Services > Credentials)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who can sign in: everyone at these domains, plus emails added on the Access page
ALLOWED_DOMAINS=learningplanetinstitute.org
# Admins (comma-separated) can open the Access page and invite guests from other domains
ADMIN_EMAILS=shoaib.qadeer@learningplanetinstitute.org,shoaibqadeer0342@gmail.com

# Gemini (brain-dump extraction and "Who are you trying to reach?")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
